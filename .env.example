# KI-Anbieter: "claude", "mistral" oder "demo".
# Leer = der erste Anbieter mit gesetztem Key (Claude, dann Mistral), sonst demo.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Optional: Modell und Aufwand (low | medium | high | xhigh | max)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Mistral (Conversations API mit eingebauter Websuche)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
# EU-Endpunkt: https://api.eu.mistral.ai
MISTRAL_BASE_URL=https://api.mistral.ai
# Optional, nur für Modelle mit Reasoning: none | minimal | low | medium | high
MISTRAL_REASONING_EFFORT=
# standard oder premium (premium bezieht zusätzlich Nachrichtenquellen ein)
MISTRAL_WEB_SEARCH=standard
# Wie viele Shops gleichzeitig recherchiert werden
PRICE_PARALLEL=4
# Maximale Recherchedauer pro Shop (Go-Dauer, z. B. 3m, 90s)
STORE_TIMEOUT=3m
ADDR=:8080
# Gebautes Frontend ausliefern (Produktion)
STATIC_DIR=
