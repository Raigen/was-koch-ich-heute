# KI-Anbieter: "claude" oder "demo". Leer = claude, wenn ein API-Key gesetzt ist, sonst demo.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Optional: Modell und Aufwand (low | medium | high | xhigh | max)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Wie viele Shops gleichzeitig recherchiert werden
PRICE_PARALLEL=4
ADDR=:8080
# Gebautes Frontend ausliefern (Produktion)
STATIC_DIR=
