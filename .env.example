# AI provider: "claude", "mistral" or "demo".
# Empty = the first provider with an API key (Claude, then Mistral), otherwise demo.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Optional: model and effort (low | medium | high | xhigh | max)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Mistral (Conversations API with built-in web search)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
# EU endpoint: https://api.eu.mistral.ai
MISTRAL_BASE_URL=https://api.mistral.ai
# Optional, reasoning models only: none | minimal | low | medium | high
MISTRAL_REASONING_EFFORT=
# standard or premium (premium also includes news sources)
MISTRAL_WEB_SEARCH=standard
# Number of shops researched concurrently
PRICE_PARALLEL=4
# Maximum research time per shop (Go duration, e.g. 3m, 90s)
STORE_TIMEOUT=3m
# Optional price table for the API cost estimate: path to a JSON file or inline JSON,
# e.g. {"eurPerUsd":0.86,"models":{"claude-opus-5-5":{"input":4,"output":20,"cacheRead":0.2,"cacheWrite":5,"webSearchPer1000":10}}}
# Entries override or extend the built-in prices (USD per million tokens / per 1,000 tool calls).
PRICE_TABLE=
ADDR=:8080
# Serve the built frontend (production)
STATIC_DIR=
